<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.chezmoi.update-agents</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/update-agents.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.kimi-code/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>XDG_STATE_HOME</key>
		<string>{{ .chezmoi.homeDir }}/.local/state</string>
	</dict>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/update-agents.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/update-agents.log</string>
</dict>
</plist>
