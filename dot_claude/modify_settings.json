# chezmoi:modify-template
{{/* Merge gateway settings; Claude Code owns the other settings. */}}
{{- $settings := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $settings = $settings | setValueAtPath "attribution" (dict "commit" "" "pr" "" "sessionUrl" false) -}}
{{- $settings = $settings | setValueAtPath "apiKeyHelper" (printf "cat %s" (joinPath .chezmoi.homeDir .ai.keyFile | quote)) -}}
{{- $settings = $settings | setValueAtPath "env.ANTHROPIC_BASE_URL" .ai.origin -}}
{{- $settings = $settings | setValueAtPath "promptCacheTtl" "1h" -}}
{{- $settings = $settings | setValueAtPath "subagentPromptCacheTtl" "5m" -}}
{{ $settings | toPrettyJson }}
