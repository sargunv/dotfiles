[Unit]
Description=Update coding agent CLIs
Documentation=https://github.com/sargunv/dotfiles
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Explicit PATH — systemd --user has minimal PATH and doesn't source zshrc/mise.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:%h/.kimi-code/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/update-agents.sh
StandardOutput=append:%h/.local/state/update-agents.log
StandardError=append:%h/.local/state/update-agents.log
