[settings]
experimental = true
install_layout = "identity"
# Let a project's own version files (.nvmrc, .python-version,
# rust-toolchain.toml, ...) override the global tools below. Without this,
# mise's global rust sets RUSTUP_TOOLCHAIN, which beats rust-toolchain.toml.
idiomatic_version_file_enable_tools = ["go", "java", "node", "python", "rust"]
# The global lockfile is per machine, so lock only the current platform.
lockfile_platforms = ["{{ replace "darwin" "macos" .chezmoi.os }}-{{ replace "amd64" "x64" .chezmoi.arch }}"]
trusted_config_paths = [
  "~/.local/share/chezmoi",
  "~/.local/share/workflow-cli",
  "~/Code",
  "~/Projects",
  "~/source/repos",
  "~/.codex/worktrees",
  "~/.t3/worktrees"
]

[settings.python]
compile = false

[settings.shims]
exclude = ["bash"]

[tools]
"core:go" = "latest"
{{ if and (eq .chezmoi.os "windows") (eq .chezmoi.arch "arm64") -}}
# Temurin does not publish a Windows ARM64 build.
"core:java" = "zulu-25"
{{ else -}}
"core:java" = "temurin-25"
{{ end -}}
"core:node" = "lts"
"core:python" = "latest"
"core:rust" = "latest"

"aqua:jdx/aube" = "latest"
"aqua:jdx/usage" = "latest"
"aqua:astral-sh/uv" = "latest"
"aqua:cargo-bins/cargo-binstall" = "latest"
"aqua:mozilla/sccache" = "latest"
"aqua:cli/cli" = { version = "latest", os = ["linux"] }
"github:Foxboron/ssh-tpm-agent" = { version = "latest", os = ["linux"] }
{{ if ne .chezmoi.os "windows" -}}
"github:sargunv/starship-multi-config" = "latest"
{{ end -}}
"vfox:mise-plugins/vfox-android-sdk" = "23.0"
