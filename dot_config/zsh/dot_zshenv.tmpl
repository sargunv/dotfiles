#!/bin/zsh

typeset -U path fpath

path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.local/share/JetBrains/Toolbox/scripts"
  "$HOME/.local/share/mise/shims"
  "$HOME/.opencode/bin"
  "$HOME/.lmstudio/bin"
  $path
)

{{ if eq .chezmoi.os "linux" -}}
# Login shells outside systemd don't get the user manager's environment.d.
for environment_file in "${XDG_CONFIG_HOME:-$HOME/.config}"/environment.d/*.conf(N); do
  set -a
  . "$environment_file"
  set +a
done
unset environment_file

# Proton's Wine runs Windows test suites that are cross-compiled on Linux.
if [ -x "$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/files/bin/wine" ]; then
  export WINE="$HOME/.local/share/Steam/steamapps/common/Proton - Experimental/files/bin/wine"
fi

{{ end -}}
export PAGER="less -RF --mouse"
export DELTA_PAGER="$PAGER"

# adb's mDNS discovery aborts its server when the LAN carries a malformed
# service record. Wireless debugging still works through `adb connect`.
export ADB_MDNS=0

{{ if eq .chezmoi.os "darwin" -}}
export SSH_SK_PROVIDER="/usr/lib/ssh-keychain.dylib"

if [ -d "/Applications/Ghostty.app/Contents/Resources/terminfo" ]; then
  export TERMINFO_DIRS="${TERMINFO_DIRS:+$TERMINFO_DIRS:}/Applications/Ghostty.app/Contents/Resources/terminfo"
fi
{{ end -}}
