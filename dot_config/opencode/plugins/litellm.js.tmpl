import { loadRouteFilter, providers } from {{ joinPath .chezmoi.homeDir ".local/lib/coding-agents/litellm.mjs" | toJson }};

const gateway = {
  origin: {{ .ai.origin | toJson }},
  keyFile: {{ joinPath .chezmoi.homeDir .ai.keyFile | toJson }},
  goPrefix: {{ .ai.goPrefix | toJson }},
};

export default {
  id: "litellm",
  async setup(ctx) {
    // Saved native-provider credentials otherwise override settings.apiKey.
    await ctx.provider.transform((editor) => {
      for (const id of providers) {
        editor.update(id, (provider) => {
          provider.integrationID = "litellm";
        });
      }
    });
    // Transforms are synchronous and replayable; fetch routes before registering.
    const visible = await loadRouteFilter(gateway);
    await ctx.model.transform((editor) => {
      for (const id of providers) {
        for (const model of editor.list(id)) {
          if (!visible(id, model.id)) {
            editor.remove(model.providerID, model.id);
          } else if (id === "opencode-go") {
            editor.update(model.providerID, model.id, (draft) => {
              draft.modelID = gateway.goPrefix + model.modelID;
            });
          }
        }
      }
    });
  },
};
