#!/bin/sh
set -eu

# Runs workflow-cli's TypeScript sources from the chezmoi external checkout. pnpm
# keeps a copy of the lockfile it last installed, so dependencies are reinstalled
# only after a pull changes them. Node 24 is resolved directly, so a project's mise
# node pin can't drop below workflow-cli's `engines` floor and `mise exec` doesn't
# trigger the project's own hooks.

dir="$HOME/.local/share/workflow-cli"

if ! cmp -s "$dir/pnpm-lock.yaml" "$dir/node_modules/.pnpm/lock.yaml"; then
  echo "Installing workflow-cli dependencies..." >&2
  (cd "$dir" && mise install --yes && mise exec -- pnpm install --frozen-lockfile) >&2
fi

exec "$(mise where node@24)/bin/node" "$dir/src/cli.ts" "$@"
